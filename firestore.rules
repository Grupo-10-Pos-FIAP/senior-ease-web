rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /activityProgress/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /activities/{activityId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Contador sequencial de matrículas — apenas incremento de +1 por usuário autenticado.
    match /counters/matriculas {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['current'])
        && request.resource.data.current is int
        && request.resource.data.current == 1;

      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['current'])
        && request.resource.data.current is int
        && resource.data.current is int
        && request.resource.data.current == resource.data.current + 1;
    }
  }
}
